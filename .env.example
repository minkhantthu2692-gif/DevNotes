# =============================================================================
# DevNotes environment example — COPY to `.env` only if you use a tool that
# injects these values. The shipped app reads src/scripts/config.js instead,
# because a static site cannot keep secrets: anything inlined into frontend
# JavaScript is public after deployment. Publishable values only.
# =============================================================================

# Supabase (publishable/anon key — safe for the browser, protected by RLS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Groq — do NOT put a shared production key here for a public deployment.
# Personal BYOK mode: users paste their own key in Settings → AI.
# For a shared deployment, use the Supabase Edge Function proxy instead
# (supabase/functions/ai-proxy) with server-side secrets.
GROQ_API_KEY=
