{
  "name": "devnotes",
  "version": "1.0.0",
  "private": true,
  "description": "DevNotes — personal, offline-first programming knowledge workspace (static app; Node is used only for development tests).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:browser": "node tests/browser/run.mjs",
    "test:ai": "node tests/browser/ai-mock.mjs",
    "serve": "npx --yes serve . -l 4173",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "fake-indexeddb": "6.2.4",
    "playwright-core": "1.64.1"
  }
}
